<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="false">

    <!-- ===== TOP APP BAR ===== -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_topbar"
        android:elevation="8dp"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/default_avatar"
                android:background="@drawable/bg_avatar"
                android:scaleType="centerCrop"
                android:contentDescription="User avatar"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAR"
                android:textColor="@color/primary"
                android:textSize="24sp"
                android:textStyle="bold|italic"
                android:letterSpacing="-0.05"
                android:fontFamily="@font/plusjakartasans" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/notifications"
            app:tint="@color/primary"
            android:contentDescription="Notifications"
            android:padding="2dp" />
    </LinearLayout>

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="108dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="120dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, "
                        android:textColor="@color/on_surface"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User123"
                        android:textColor="@color/primary"
                        android:textSize="40sp"
                        android:textStyle="bold|italic"
                        android:fontFamily="@font/plusjakartasans" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your regenerative oasis is flourishing. Today\'s environmental impact is "
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.5"
                    android:fontFamily="@font/manrope" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+12%"
                        android:textColor="@color/secondary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/manrope" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" higher than yesterday."
                        android:textColor="@color/on_surface_variant"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/cardReport"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/add_a_photo"
                        app:tint="@color/primary"
                        android:contentDescription="Report"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEW WASTE STAR"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardTrack"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/monitoring"
                        app:tint="@color/secondary"
                        android:contentDescription="Track"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE PROGRESS"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/cardHistory"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/history_edu"
                        app:tint="@color/tertiary"
                        android:contentDescription="History"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAST ACTIONS"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardChatbot"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pebble_card"
                    android:clipToOutline="true"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="Chatbot"
                        android:src="@drawable/smart_toy"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasans"
                        android:text="Chatbot"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:letterSpacing="0.15"
                        android:text="AI ASSISTANT"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/cardInfo"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/lightbulb"
                        app:tint="@color/secondary"
                        android:contentDescription="Info"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Info"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ECO TIPS"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardLocate"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/near_me"
                        app:tint="@color/primary"
                        android:contentDescription="Locate"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Locate"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIND CENTERS"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/cardEco"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pebble_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/eco_leaf"
                        app:tint="@color/tertiary"
                        android:contentDescription="ECO"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ECO"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR SCORE"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardLogout"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pebble_card_dark"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="bottom"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/logout"
                        app:tint="@color/error"
                        android:contentDescription="Logout"
                        android:layout_gravity="start"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logout"
                        android:textColor="@color/error"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="END SESSION"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </LinearLayout>

            <!-- MAP -->
            <FrameLayout
                android:id="@+id/mapSection"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pebble_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/ivMapPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_map_placeholder"
                    android:scaleType="centerCrop"
                    android:alpha="0.5"
                    android:contentDescription="Map" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_map_gradient" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nearby Cleanup Events"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plusjakartasans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 events active in your neighborhood"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM NAV AREA =====
         Gunakan RelativeLayout sebagai wrapper utama.
         Ini cara paling andal agar FAB bisa overlap ke atas navbar
         tanpa terpotong sama sekali.
    -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Navbar background + 4 tab (Home, Locate, [space], ECO, History) -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="horizontal"
            android:weightSum="5"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp">

            <!-- Home (Active) -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_nav_active"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/grid_view"
                    app:tint="@color/primary"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    android:textColor="@color/primary"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Locate -->
            <LinearLayout
                android:id="@+id/navLocate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/distance"
                    app:tint="@color/on_surface_variant"
                    android:contentDescription="Locate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCATE"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Spacer tengah untuk FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- ECO -->
            <LinearLayout
                android:id="@+id/navEco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/eco_leaf"
                    app:tint="@color/on_surface_variant"
                    android:contentDescription="ECO" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ECO"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/history"
                    app:tint="@color/on_surface_variant"
                    android:contentDescription="History" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HISTORY"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- FAB Scan — diposisikan di atas navbar menggunakan RelativeLayout
             layout_centerHorizontal + layout_alignParentTop menjamin
             FAB selalu pas di tengah dan tidak terpotong -->
        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="20dp">

            <!-- Lingkaran FAB hijau -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_fab"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/center_focus"
                    app:tint="@color/on_primary"
                    android:contentDescription="Scan" />
            </FrameLayout>

            <!-- Label SCAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SCAN"
                android:textColor="@color/primary"
                android:textSize="7sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>